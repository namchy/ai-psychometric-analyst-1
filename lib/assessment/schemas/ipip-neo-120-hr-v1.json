{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ipip-neo-120-hr-v2",
  "title": "IPIP-NEO-120 HR Report v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "test",
    "meta",
    "headline",
    "executive_summary",
    "key_hr_signals",
    "verification_focus",
    "interview_questions",
    "strengths_and_overuse_risks",
    "domain_overview",
    "onboarding_and_management_guidance",
    "team_fit_notes",
    "decision_support_note",
    "interpretation_note"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "ipip_neo_120_hr_v2"
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "name"],
      "properties": {
        "code": {
          "type": "string",
          "const": "ipip_neo_120"
        },
        "name": {
          "type": "string",
          "const": "IPIP-NEO-120"
        }
      }
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "audience"],
      "properties": {
        "language": {
          "type": "string",
          "const": "bs"
        },
        "audience": {
          "type": "string",
          "const": "hr"
        }
      }
    },
    "headline": {
      "type": "string",
      "minLength": 1
    },
    "executive_summary": {
      "type": "string",
      "minLength": 1
    },
    "key_hr_signals": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "evidence", "hr_implication"],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "evidence": { "type": "string", "minLength": 1 },
          "hr_implication": { "type": "string", "minLength": 1 }
        }
      }
    },
    "verification_focus": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["area", "why_it_matters", "how_to_check"],
        "properties": {
          "area": { "type": "string", "minLength": 1 },
          "why_it_matters": { "type": "string", "minLength": 1 },
          "how_to_check": { "type": "string", "minLength": 1 }
        }
      }
    },
    "interview_questions": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["question", "evaluates", "what_good_answer_may_show"],
        "properties": {
          "question": { "type": "string", "minLength": 1 },
          "evaluates": { "type": "string", "minLength": 1 },
          "what_good_answer_may_show": { "type": "string", "minLength": 1 }
        }
      }
    },
    "strengths_and_overuse_risks": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "trait_or_pattern",
          "possible_strengths",
          "possible_overuse_risks",
          "hr_handling_tip"
        ],
        "properties": {
          "trait_or_pattern": { "type": "string", "minLength": 1 },
          "possible_strengths": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": { "type": "string", "minLength": 1 }
          },
          "possible_overuse_risks": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": { "type": "string", "minLength": 1 }
          },
          "hr_handling_tip": { "type": "string", "minLength": 1 }
        }
      }
    },
    "domain_overview": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "domain_name",
          "score_label_or_band",
          "concise_meaning",
          "hr_relevance",
          "check_in_interview",
          "top_facets"
        ],
        "properties": {
          "domain_name": {
            "type": "string",
            "enum": [
              "Ekstraverzija",
              "Spremnost na saradnju",
              "Savjesnost",
              "Neuroticizam",
              "Otvorenost prema iskustvu"
            ]
          },
          "score_label_or_band": {
            "type": "string",
            "enum": ["low", "moderate", "high"]
          },
          "concise_meaning": { "type": "string", "minLength": 1 },
          "hr_relevance": { "type": "string", "minLength": 1 },
          "check_in_interview": { "type": "string", "minLength": 1 },
          "top_facets": {
            "type": "array",
            "minItems": 0,
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["facet_name", "score_label_or_band", "relevance"],
              "properties": {
                "facet_name": { "type": "string", "minLength": 1 },
                "score_label_or_band": {
                  "type": "string",
                  "enum": ["low", "moderate", "high"]
                },
                "relevance": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "onboarding_and_management_guidance": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["recommendation", "why", "first_30_days_application"],
        "properties": {
          "recommendation": { "type": "string", "minLength": 1 },
          "why": { "type": "string", "minLength": 1 },
          "first_30_days_application": { "type": "string", "minLength": 1 }
        }
      }
    },
    "team_fit_notes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fit_condition", "may_work_well_when", "watchout"],
        "properties": {
          "fit_condition": { "type": "string", "minLength": 1 },
          "may_work_well_when": { "type": "string", "minLength": 1 },
          "watchout": { "type": "string", "minLength": 1 }
        }
      }
    },
    "decision_support_note": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "interpretation_note": {
      "type": "string",
      "minLength": 1
    }
  }
}
