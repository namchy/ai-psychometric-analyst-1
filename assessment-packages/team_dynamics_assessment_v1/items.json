  },
  {
    "code": "SJT_TD_01",
    "text": "Na timskom sastanku razgovarate o kasnjenju vaznog zadatka. Rasprava pocinje kao razgovor o poslu, ali se brzo pretvara u licne komentare. Jedan clan tima kaze drugom: \"Ti uvijek zakomplikujes stvari i nikad ne zavrsis ono sto obecas.\" Druga osoba se brani povisenim tonom, a ostatak tima uglavnom suti. Rok je blizu i jasno je da problem treba rijesiti, ali atmosfera postaje sve napetija.",
    "question_type": "multiple_choice",
    "question_order": 39,
    "is_required": true,
    "is_active": true,
    "mappings": [
      { "dimension_code": "SJT_TOTAL", "weight": 1, "reverse_scored": false },
      { "dimension_code": "SJT_CONSTRUCTIVE_CONFLICT", "weight": 1, "reverse_scored": false }
    ],
    "metadata": {
      "block_key": "situational_judgment",
      "response_format": "best_worst",
      "instruction_type": "knowledge_based_should_do",
      "user_instruction": "Odaberi najefikasniju i najmanje efikasnu reakciju u ovoj situaciji. Ne biras sta bi ti licno najvjerovatnije uradio/la, nego sta bi u ovoj situaciji najvise pomoglo timu da konstruktivno rijesi problem.",
      "scenario_title": "Konflikt koji prelazi u personalizaciju",
      "primary_dimension": "constructive_conflict",
      "user_facing_dimension": "Konstruktivno rjesavanje konflikta",
      "options": [
        { "option_id": "SJT_TD_01_A", "option_order": 1, "option_text": "Predlozim da se razgovor vrati na konkretan zadatak: sta tacno kasni, sta je blokada i koji je prvi sljedeci korak. Naglasim da licne ocjene ne pomazu rjesavanju problema.", "option_level": "Acceptable" },
        { "option_id": "SJT_TD_01_B", "option_order": 2, "option_text": "Sacekam da se rasprava sama smiri, jer bi moje ukljucivanje moglo dodatno pojacati tenziju. Nakon sastanka bih mozda pojedinacno pitao/la sta se desilo.", "option_level": "Weak" },
        { "option_id": "SJT_TD_01_C", "option_order": 3, "option_text": "Kazem da je ocigledno ko je odgovoran za kasnjenje i da tim vise ne moze stalno tolerisati isti obrazac ponasanja.", "option_level": "Harmful" },
        { "option_id": "SJT_TD_01_D", "option_order": 4, "option_text": "Predlozim kratku pauzu da se smiri ton, pa da razgovor vratimo na cinjenice: sta kasni, kakav je uticaj na rok i koji je sljedeci dogovor.", "option_level": "Best" }
      ]
    }
  },
  {
    "code": "SJT_TD_02",
    "text": "Radite na zajednickom zadatku koji treba biti zavrsen do kraja sedmice. Jedan clan tima je preuzeo vazan dio posla, ali jos nije isporucio dogovoreno. Bez tog dijela ostatak tima ne moze zavrsiti svoj posao. Rok je blizu, a osoba koja kasni na sastancima govori da \"radi na tome\", ali ne daje konkretan novi termin. U timu raste frustracija, ali niko ne zeli otvoriti neugodan razgovor.",
    "question_type": "multiple_choice",
    "question_order": 40,
    "is_required": true,
    "is_active": true,
    "mappings": [
      { "dimension_code": "SJT_TOTAL", "weight": 1, "reverse_scored": false },
      { "dimension_code": "SJT_OWNERSHIP", "weight": 1, "reverse_scored": false },
      { "dimension_code": "SJT_COORDINATION", "weight": 1, "reverse_scored": false }
    ],
    "metadata": {
      "block_key": "situational_judgment",
      "response_format": "best_worst",
      "instruction_type": "knowledge_based_should_do",
      "user_instruction": "Odaberi najefikasniju i najmanje efikasnu reakciju u ovoj situaciji. Ne biras sta bi ti licno najvjerovatnije uradio/la, nego sta bi u ovoj situaciji najvise pomoglo timu da konstruktivno rijesi problem.",
      "scenario_title": "Kasnjenje ili neizvrsenje dogovora",
      "primary_dimension": "ownership",
      "secondary_dimension": "coordination",
      "user_facing_dimension": "Preuzimanje odgovornosti",
      "options": [
        { "option_id": "SJT_TD_02_A", "option_order": 1, "option_text": "Direktno razgovaram s clanom tima koji kasni, trazim da jasno kaze sta ga blokira i predlazem da zajedno dogovorimo realan novi rok i sljedeci korak.", "option_level": "Acceptable" },
        { "option_id": "SJT_TD_02_B", "option_order": 2, "option_text": "Preuzmem njegov dio posla da tim ne bi probio rok, a kasnije cemo razgovarati o tome zasto se ovo desilo.", "option_level": "Weak" },
        { "option_id": "SJT_TD_02_C", "option_order": 3, "option_text": "Na zajednickom kanalu napisem da cijeli tim kasni zbog jedne osobe, kako bi svima bilo jasno gdje je problem.", "option_level": "Harmful" },
        { "option_id": "SJT_TD_02_D", "option_order": 4, "option_text": "Predlozim da odmah razjasnimo sta nedostaje, sta blokira ostatak tima, ko moze pomoci i koji je realan novi rok.", "option_level": "Best" }
      ]
    }
  },
  {
    "code": "SJT_TD_03",
    "text": "Tokom rada na zajednickom projektu pojavljuje se vazan zadatak koji mora biti zavrsen prije sljedeceg sastanka s klijentom. Zadatak se nalazi izmedju nekoliko podrucja rada i nije jasno ko je njegov vlasnik. Zadatak nije tezak sam po sebi, ali trazi informacije iz vise dijelova tima. Svako pretpostavlja da ce ga preuzeti neko drugi. Na sastanku se tema kratko spomene, ali niko ne preuzima odgovornost, a rok se priblizava. Ako zadatak ostane nerijesen, cijeli tim ce izgledati nespremno.",
    "question_type": "multiple_choice",
    "question_order": 41,
    "is_required": true,
    "is_active": true,
    "mappings": [
      { "dimension_code": "SJT_TOTAL", "weight": 1, "reverse_scored": false },
