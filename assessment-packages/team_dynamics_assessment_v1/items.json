    "question_order": 30,
    "is_required": true,
    "is_active": true,
    "mappings": [
      { "dimension_code": "TDM_CORE_TOTAL", "weight": 1, "reverse_scored": false },
      { "dimension_code": "TDM_COMMUNICATION", "weight": 1, "reverse_scored": false }
    ],
    "metadata": { "block_key": "tdm-31-V1", "domain_group": "Communication", "domain_scored": true, "reverse_scored": false, "response_scale": "likert_1_4_agreement" }
  },
  {
