      "user_facing_dimension": "Pravovremeno otvaranje rizika",
      "options": [
        { "option_id": "SJT_TD_04_A", "option_order": 1, "option_text": "Zabiljezim sta sam primijetio/la, procijenim moguci uticaj i predlozim kratak razgovor o tome da li problem rjesavamo sada ili uvodimo jasnu kontrolu.", "option_level": "Best" },
        { "option_id": "SJT_TD_04_B", "option_order": 2, "option_text": "Sacekam da vidim hoce li problem stvarno postati ozbiljan, jer je tim vec pod pritiskom i nije korisno otvarati svaku mogucu komplikaciju.", "option_level": "Weak" },
        { "option_id": "SJT_TD_04_C", "option_order": 3, "option_text": "Odmah posaljem poruku svima da postoji ozbiljan problem i da trenutni plan vjerovatno nece uspjeti ako se hitno ne promijeni.", "option_level": "Acceptable" },
        { "option_id": "SJT_TD_04_D", "option_order": 4, "option_text": "Pokusam sam/a rijesiti problem usput, bez otvaranja teme timu, jer ne zelim dodatno opteretiti druge niti izazvati novu raspravu pred rok.", "option_level": "Harmful" }
