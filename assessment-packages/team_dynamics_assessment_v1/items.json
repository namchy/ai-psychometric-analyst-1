        { "option_id": "SJT_TD_06_B", "option_order": 2, "option_text": "Predlozim da se ubuduce sve vazne informacije salju u zajednicki kanal, ali sada nastavim raditi na dijelu koji je meni dodijeljen da ne gubimo dodatno vrijeme.", "option_level": "Acceptable" },
