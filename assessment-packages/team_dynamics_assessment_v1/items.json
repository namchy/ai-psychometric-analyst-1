    "text": "U ovom timu vodjstvo preuzima osoba koja je najprikladnija za konkretan zadatak.",
    "question_type": "single_choice",
    "question_order": 31,
    "is_required": true,
    "is_active": true,
    "mappings": [
      { "dimension_code": "TDM_CORE_TOTAL", "weight": 1, "reverse_scored": false },
