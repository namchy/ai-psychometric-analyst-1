    "metadata": { "block_key": "tdm-31-V1", "domain_group": "overall_rasch_only", "domain_scored": false, "reverse_scored": false, "response_scale": "likert_1_4_agreement" }
  },
  {
    "code": "TPSDP_1",
    "text": "Kada se u ovom timu napravi greska, cesce razgovaramo o tome sta mozemo nauciti nego o tome koga treba okriviti.",
    "question_type": "single_choice",
    "question_order": 32,
    "is_required": true,
    "is_active": true,
    "mappings": [
      { "dimension_code": "PSYCHOLOGICAL_SAFETY", "weight": 1, "reverse_scored": false }
    ],
    "metadata": { "block_key": "psychological_safety", "construct": "Greske", "reverse_scored": false, "response_scale": "likert_1_4_agreement" }
  },
  {
    "code": "TPSDP_2",
    "text": "U ovom timu je uobicajeno otvoreno reci kada nesto ne funkcionise, cak i ako je razgovor neugodan.",
    "question_type": "single_choice",
    "question_order": 33,
    "is_required": true,
    "is_active": true,
    "mappings": [
      { "dimension_code": "PSYCHOLOGICAL_SAFETY", "weight": 1, "reverse_scored": false }
    ],
    "metadata": { "block_key": "psychological_safety", "construct": "Problemi i rizici", "reverse_scored": false, "response_scale": "likert_1_4_agreement" }
  },
  {
    "code": "TPSDP_3",
    "text": "Ljudi u ovom timu ozbiljno razmatraju ideje koje se razlikuju od uobicajenog nacina razmisljanja.",
    "question_type": "single_choice",
    "question_order": 34,
    "is_required": true,
    "is_active": true,
    "mappings": [
      { "dimension_code": "PSYCHOLOGICAL_SAFETY", "weight": 1, "reverse_scored": false }
    ],
    "metadata": { "block_key": "psychological_safety", "construct": "Drugacije misljenje", "reverse_scored": false, "response_scale": "likert_1_4_agreement" }
  },
  {
    "code": "TPSDP_4",
    "text": "Mogu predloziti rjesenje za koje nisam siguran/na da ce uspjeti, bez straha da ce to narusiti moj ugled u timu.",
    "question_type": "single_choice",
    "question_order": 35,
    "is_required": true,
    "is_active": true,
    "mappings": [
      { "dimension_code": "PSYCHOLOGICAL_SAFETY", "weight": 1, "reverse_scored": false }
    ],
    "metadata": { "block_key": "psychological_safety", "construct": "Interpersonalni rizik", "reverse_scored": false, "response_scale": "likert_1_4_agreement" }
  },
  {
    "code": "TPSDP_5",
    "text": "Prirodno mi je zatraziti pomoc od nekoga iz tima kada zapnem.",
