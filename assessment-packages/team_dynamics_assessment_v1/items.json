      "options": [
        { "option_id": "SJT_TD_05_A", "option_order": 1, "option_text": "Predlozim kratak dogovor: sta se zaustavlja, sta se cuva za kasnije, sta prelazi u novi prioritet i koji su prvi koraci za naredna dva dana.", "option_level": "Best" },
        { "option_id": "SJT_TD_05_B", "option_order": 2, "option_text": "Prihvatim novi prioritet i odmah krenem raditi na njemu, jer je najvaznije pokazati fleksibilnost i ne gubiti vrijeme na raspravu o odluci koja je vec donesena.", "option_level": "Acceptable" },
        { "option_id": "SJT_TD_05_C", "option_order": 3, "option_text": "Kazem da tim ne treba mijenjati plan dok se ne dobije detaljno objasnjenje zasto se raniji rad prekida i ko je odgovoran za promjenu smjera.", "option_level": "Weak" },
